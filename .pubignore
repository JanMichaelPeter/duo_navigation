# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
tool/

# Design notes are not part of the package. (packages/ can't be listed here:
# pub applies this file to the workspace members too and would hide them.)
doc/design/

# Only these root-level Markdown files belong in the package
/*.md
!/README.md
!/CHANGELOG.md
